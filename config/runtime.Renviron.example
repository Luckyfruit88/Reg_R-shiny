# Optional settings for this clone. Copy to runtime.Renviron only when needed.
# New clones use Data sources profiles; no private VCF/BAM manifest paths needed.
# RStudio already supplies its own startup tempdir and R library paths.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
REGSHINY_SGE_PROJECT=mtdna-alcohol
# Each new full variant job requests 16 cores independently.
REGSHINY_FULL_WALLTIME=12:00:00
# Optional custom initial dataset, kept outside Git:
# REGSHINY_PROFILE_CONFIG=/absolute/path/to/my-profile.json
# Optional worker reduction within the RStudio NSLOTS budget:
# REGSHINY_UI_WORKERS=1
